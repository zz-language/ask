// search.zz — fuzzy-filter select: type to narrow, arrows to move.
//
// Layout: one filter input row (borrowed line editor, cursor parked in
// the query) plus up to SEARCH_ROWS matches below. Every keystroke
// erases from the prompt line down (`ansi.wipe_down`) and reprints —
// never an upward wipe, because the cursor rests on the FIRST block
// line, not below it (an upward wipe from there would eat scrollback).
// Up/Down moves in the filtered list, Enter accepts the highlight,
// Esc cancels with "", Ctrl+C exits(130).
import std.process
import std.term
import std.vec
import ansi
import buf
import fallback
import keys
import line
import theme

/// Max matches shown under the filter row.
pub const SEARCH_ROWS: int = 8

/// Case-insensitive substring match; empty queries match all (pure).
pub func matches(q: str, opt: str) -> bool {
    if q == "" {
        return true
    }
    opt.to_lower().contains(q.to_lower())
}

/// Options matching `q` in order (pure).
pub func filter_options(q: str, options: [str]) -> [str] {
    out: [str] = []
    for opt in options {
        if matches(q, opt) {
            out = vec.push(out, opt)
        }
    }
    out
}

/// Restore the terminal and terminate with code 130 (Ctrl+C).
func die() -> str {
    ansi.restore()
    process.exit(130)
    ""
}

/// True when stdin can do raw interactive menus.
func live() -> bool {
    if term.is_tty() == false {
        return false
    }
    match term.enable_raw() {
        .ok(_) => true
        .err(_) => false
    }
}

/// One match row: marker + accented label on the highlight.
func srow(opt: str, active: bool) -> str {
    t := theme.current()
    if active {
        return t.marker + theme.paint(t, "bold", theme.paint(t, t.accent, opt))
    }
    "  " + opt
}

/// Print the filter row plus `rows`, then park the cursor back inside
/// the query. The prompt row is ended explicitly (draw_input emits no
/// newline — without it the first row glues onto the prompt), rows end
/// with `\r\n` (raw mode kills ONLCR), then climb `1 + rows` back to
/// the prompt and step right over "? " + msg + " " + query offset.
func draw(msg: str, q: buf.Line, rows: [str]) {
    t := theme.current()
    line.draw_input(theme.headline(t, msg) + " ", q, false, "*")
    print("\r\n")
    for r in rows {
        print(r + "\r\n")
    }
    up := 1 + vec.len(rows)
    print("\x1b[{up}A")
    fwd := len(t.prefix) + len(msg) + 1 + q.cursor
    print("\r\x1b[{fwd}C")
    term.flush()
}

/// Visible rows for `opts` with `idx` highlighted (capped + overflow).
func vis_rows(opts: [str], idx: int) -> [str] {
    shown := opts
    if vec.len(opts) > SEARCH_ROWS {
        shown = opts[:SEARCH_ROWS]
    }
    out: [str] = []
    i := 0
    for opt in shown {
        if i == idx {
            out = vec.push(out, srow(opt, true))
        } else {
            out = vec.push(out, srow(opt, false))
        }
        i = i + 1
    }
    if vec.len(opts) > SEARCH_ROWS {
        out = vec.push(out, "  ...{vec.len(opts) - SEARCH_ROWS} more")
    }
    out
}

/// Fuzzy select. Type narrows the list (every printable byte, `j`
/// and `k` included), Up/Down moves, Enter accepts, Esc cancels ("").
/// Non-TTY falls back to a numbered pick.
pub func search(msg: str, options: [str]) -> str {
    n := vec.len(options)
    if n == 0 {
        return ""
    }
    if live() == false {
        return fallback.pick(msg + " (filter)", options)
    }
    ansi.show()
    ansi.bar()
    q := buf.blank()
    idx := 0
    hits := filter_options("", options)
    rows := vis_rows(hits, idx)
    draw(msg, q, rows)
    stop := false
    while stop == false {
        k := keys.next()
        if k == keys.KEY_EOF {
            stop = true
        } else if k == keys.KEY_CTRL_C {
            return die()
        } else if k == keys.KEY_ENTER {
            stop = true
        } else if k == keys.KEY_ESC {
            ansi.restore()
            ansi.wipe_down()
            ansi.answer(msg, "(cancelled)")
            return ""
        } else if k == keys.KEY_UP {
            if vec.len(hits) > 0 {
                idx = (idx + vec.len(hits) - 1) % vec.len(hits)
                rows = vis_rows(hits, idx)
                ansi.wipe_down()
                draw(msg, q, rows)
            }
        } else if k == keys.KEY_DOWN {
            if vec.len(hits) > 0 {
                idx = (idx + 1) % vec.len(hits)
                rows = vis_rows(hits, idx)
                ansi.wipe_down()
                draw(msg, q, rows)
            }
        } else if k == keys.KEY_BACKSPACE || k == 8 {
            q = q.backspace()
            hits = filter_options(q.text(), options)
            idx = 0
            rows = vis_rows(hits, idx)
            ansi.wipe_down()
            draw(msg, q, rows)
        } else if k >= 32 && k <= 126 {
            q = q.insert(line.glyph(k))
            hits = filter_options(q.text(), options)
            idx = 0
            rows = vis_rows(hits, idx)
            ansi.wipe_down()
            draw(msg, q, rows)
        }
    }
    ansi.restore()
    ansi.wipe_down()
    if vec.len(hits) == 0 {
        ansi.answer(msg, "(none)")
        return ""
    }
    ansi.answer(msg, hits[idx])
    hits[idx]
}
