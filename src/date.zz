// date.zz — month-grid calendar picker returning ISO "YYYY-MM-DD".
//
// The cursor is an absolute day number (days since the unix epoch),
// so arrows never need month-edge cases; the viewed month derives
// from it. Civil algorithms are Howard Hinnant's (pure, tested).
// Grid: Su..Sa header + 6 week rows (constant 8-line block, cursor
// below like `select`). Left/Right ±1 day, Up/Down ±week, [/] or
// PgUp/PgDn ±month, Enter accepts, Esc cancels (""), Ctrl+D accepts.
import std.process
import std.str
import std.term
import std.time
import std.vec
import ansi
import fallback
import keys
import theme

/// Gregorian leap year (pure).
pub func is_leap(y: int) -> bool {
    if y % 4 != 0 {
        return false
    }
    if y % 100 != 0 {
        return true
    }
    y % 400 == 0
}

/// Days in a month (pure).
pub func month_len(y: int, m: int) -> int {
    if m == 2 {
        if is_leap(y) {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    31
}

/// Days since epoch for a civil date, y > 0 (pure).
pub func ymd_to_days(y: int, m: int, d: int) -> int {
    yy := y
    mm := m
    if mm <= 2 {
        yy = yy - 1
        mm = mm + 12
    }
    era := yy / 400
    yoe := yy - era * 400
    doy := (153 * (mm - 3) + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

/// Civil date for a day number (pure).
pub func days_to_ymd(z: int) -> [int] {
    zz := z + 719468
    era := zz / 146097
    doe := zz - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := mp + 3
    if mp >= 10 {
        m = mp - 9
        y = y + 1
    }
    [y, m, d]
}

/// Weekday, Sunday == 0 (1970-01-01 was a Thursday). Pure.
pub func dow_sun0(days: int) -> int {
    ((days + 4) % 7 + 7) % 7
}

/// Today as a day number.
pub func today() -> int {
    time.now_ms() / 86400000
}

/// Two-digit padding (pure).
pub func pad2(n: int) -> str {
    if n < 10 {
        return "0{str(n)}"
    }
    str(n)
}

/// ISO date for a day number (pure).
pub func iso(days: int) -> str {
    v := days_to_ymd(days)
    "{v[0]}-{pad2(v[1])}-{pad2(v[2])}"
}

/// Parse "YYYY-MM-DD" into [y, m, d], [] when malformed (pure).
pub func parse_date(s: str) -> [int] {
    parts := str.split(s, "-")
    if vec.len(parts) != 3 {
        return []
    }
    y := int(parts[0]) ?? -1
    m := int(parts[1]) ?? -1
    d := int(parts[2]) ?? -1
    if valid_ymd(y, m, d) == false {
        return []
    }
    [y, m, d]
}

/// Range check for a civil date triple (pure).
pub func valid_ymd(y: int, m: int, d: int) -> bool {
    if y < 1 || m < 1 || m > 12 || d < 1 {
        return false
    }
    d <= month_len(y, m)
}

/// "YYYY-MM-DD" shape check for fallback input (pure).
pub func valid_date(s: str) -> bool {
    vec.len(parse_date(s)) == 3
}

/// Month names for the header (pure).
pub func month_name(m: int) -> str {
    names := ["", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
    if m < 1 || m > 12 {
        return "?"
    }
    names[m]
}

/// Space-padded day cell (pure).
pub func cell(d: int) -> str {
    if d < 10 {
        return " {str(d)}"
    }
    str(d)
}

/// Restore the terminal and terminate with code 130 (Ctrl+C).
func die() -> str {
    ansi.restore()
    process.exit(130)
    ""
}

/// True when stdin can do raw interactive picking.
func live() -> bool {
    if term.is_tty() == false {
        return false
    }
    match term.enable_raw() {
        .ok(_) => true
        .err(_) => false
    }
}

/// Shift a viewed month by `delta`, clamping the day (pure logic on
/// the triple, returns a new day number).
pub func shift_month(days: int, delta: int) -> int {
    v := days_to_ymd(days)
    y := v[0]
    m := v[1] + delta
    while m < 1 {
        m = m + 12
        y = y - 1
    }
    while m > 12 {
        m = m - 12
        y = y + 1
    }
    d := v[2]
    dim := month_len(y, m)
    if d > dim {
        d = dim
    }
    ymd_to_days(y, m, d)
}

/// Print the 8-line calendar block for the cursor's month: header,
/// weekday row, then exactly 6 week rows (short months pad with blank
/// rows so h == 8 always holds for wiping).
func draw(msg: str, days: int) {
    t := theme.current()
    v := days_to_ymd(days)
    print(theme.headline(t, msg) + "  < {month_name(v[1])} {v[0]} >\r\n")
    print("Su Mo Tu We Th Fr Sa\r\n")
    first := ymd_to_days(v[0], v[1], 1)
    col := dow_sun0(first)
    line_out := ""
    i := 0
    while i < col {
        line_out = line_out + "   "
        i = i + 1
    }
    d := 1
    dim := month_len(v[0], v[1])
    cur := days_to_ymd(days)
    rows_done := 0
    while d <= dim {
        label := cell(d)
        if d == cur[2] {
            label = ">" + cell(d)
            label = theme.paint(t, "bold", theme.paint(t, t.accent, label))
        } else {
            label = " " + cell(d)
        }
        line_out = line_out + label
        col = col + 1
        if col > 6 {
            print(line_out + "\r\n")
            line_out = ""
            col = 0
            rows_done = rows_done + 1
        } else {
            line_out = line_out + " "
        }
        d = d + 1
    }
    if col != 0 {
        while col <= 6 {
            line_out = line_out + "   "
            col = col + 1
        }
        print(line_out + "\r\n")
        rows_done = rows_done + 1
    }
    while rows_done < 6 {
        print("\r\n")
        rows_done = rows_done + 1
    }
    term.flush()
}

/// Calendar picker. Returns "YYYY-MM-DD"; Esc cancels ("").
pub func date(msg: str, default: str) -> str {
    start := today()
    parsed := parse_date(default)
    if vec.len(parsed) == 3 {
        start = ymd_to_days(parsed[0], parsed[1], parsed[2])
    }
    if live() == false {
        return fallback.line_validated(msg + " (YYYY-MM-DD):", default, valid_date, "Use YYYY-MM-DD.")
    }
    ansi.hide()
    cur := start
    h := 8
    draw(msg, cur)
    stop := false
    cancelled := false
    while stop == false {
        k := keys.next()
        if k == keys.KEY_EOF || k == 4 {
            stop = true
        } else if k == keys.KEY_CTRL_C {
            return die()
        } else if k == keys.KEY_ENTER {
            stop = true
        } else if k == keys.KEY_ESC {
            cancelled = true
            stop = true
        } else if k == keys.KEY_LEFT {
            cur = cur - 1
        } else if k == keys.KEY_RIGHT {
            cur = cur + 1
        } else if k == keys.KEY_UP {
            cur = cur - 7
        } else if k == keys.KEY_DOWN {
            cur = cur + 7
        } else if k == 91 || k == 5 {
            cur = shift_month(cur, -1)
        } else if k == 93 || k == 6 {
            cur = shift_month(cur, 1)
        } else {
            continue
        }
        if stop == false {
            ansi.wipe(h)
            draw(msg, cur)
        }
    }
    ansi.restore()
    ansi.wipe(h)
    if cancelled {
        ansi.answer(msg, "(cancelled)")
        return ""
    }
    ansi.answer(msg, iso(cur))
    iso(cur)
}
