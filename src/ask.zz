// ask — advanced interactive CLI prompts. Pure ZZ, zero dependencies
// (only `std` modules: colors, fs, process, str, term, vec).
//
//   import ask
//
//   name := ask.text("Name:", "", |s: str| s != "", "Name is required")
//   age := ask.number("Age:", 30, 1, 120)
//   ok := ask.confirm("Deploy?", false)
//   pw := ask.password("Token:")
//   cfg := ask.text_path("Config:", "./")
//   env := ask.select("Target:", ["dev", "stage", "prod"])
//   shell := ask.search("Shell:", ["bash", "zsh", "fish"])
//   feats := ask.multi_select("Features:", ["logs", "cache", "tls"])
//
// Every prompt collapses to one clean `? msg answer` line when done.
// Piped stdin (no TTY) degrades to plain `input()` automatically, so
// scripts and `zz test` keep working without a terminal.
import confirm as cf
import editor as ed
import form as fm
import line
import number as num
import search as sch
import select as sel
import area as ar
import theme

/// Text input with real-time line editing (arrows, Home/End,
// Backspace/Delete, bar cursor). Retries until `validator` passes;
// failures print `err_msg` in red below and keep the buffer.
pub func text(msg: str, default: str, validator: func(str) -> bool) -> str {
    line.text(msg, default, validator, "Invalid input, try again.")
}

/// Text input with a custom validation message.
pub func text_msg(msg: str, default: str, validator: func(str) -> bool, err_msg: str) -> str {
    line.text(msg, default, validator, err_msg)
}

/// Masked input: typed characters echo as `*`. Enter accepts.
pub func password(msg: str) -> str {
    line.password(msg, "*")
}

/// Masked input with a custom mask character.
pub func password_mask(msg: str, mask: str) -> str {
    line.password(msg, mask)
}

/// Path input: line editing plus Tab completion against the file
/// system (unique directory matches gain a trailing `/`).
pub func text_path(msg: str, default: str) -> str {
    line.text_path(msg, default)
}

/// Ranged integer input (`Age [1-120]: `). Garbage and out-of-range
/// answers re-ask with a red hint. Returns the accepted number.
pub func number(msg: str, default: int, lo: int, hi: int) -> int {
    num.number(msg, default, lo, hi)
}

/// Open `$EDITOR` (VISUAL, EDITOR, else vi) on a tempfile pre-filled
/// with `default`; returns the saved contents. Aborted edits keep
/// the default. Piped stdin reads lines until an empty line.
pub func editor(msg: str, default: str) -> str {
    ed.editor(msg, default)
}

/// Editor input with a custom scratch extension (`"md"` highlights
/// markdown in the editor).
pub func editor_ext(msg: str, default: str, ext: str) -> str {
    ed.editor_ext(msg, default, ext)
}

/// Destructive confirmation: the user must type `word` exactly —
/// anything else aborts with false.
pub func confirm_danger(msg: str, word: str) -> bool {
    cf.confirm_danger(msg, word)
}

/// Destructive confirmation for the common `DELETE` word.
pub func confirm_delete(msg: str) -> bool {
    cf.confirm_delete(msg)
}

/// Multi-line text area: arrows move, Enter splits lines, Tab
/// indents, Ctrl+D accepts, Esc cancels (""). Shows a scrolling
/// `rows`-tall window with soft wrapping. Returns the joined text.
pub func area(msg: str, default: str, rows: int) -> str {
    ar.area(msg, default, rows)
}

/// Switch the visual theme mid-process: "default", "mono", "ocean".
/// Also honored: `ASK_THEME` env, and any `NO_COLOR` presence.
pub func set_theme(name: str) -> bool {
    theme.set_theme(name)
}

/// Available theme names.
pub func theme_names() -> [str] {
    theme.names()
}

/// One text field for `form`.
pub func field_text(msg: str, default: str) -> fm.Field {
    fm.field_text(msg, default)
}

/// One masked field for `form`.
pub func field_password(msg: str) -> fm.Field {
    fm.field_password(msg)
}

/// One yes/no field for `form` (Enter toggles).
pub func field_confirm(msg: str, def: bool) -> fm.Field {
    fm.field_confirm(msg, def)
}

/// One cycling-choice field for `form` (Left/Right changes).
pub func field_select(msg: str, options: [str]) -> fm.Field {
    fm.field_select(msg, options)
}

/// One ranged-integer field for `form`.
pub func field_number(msg: str, default: int, lo: int, hi: int) -> fm.Field {
    fm.field_number(msg, default, lo, hi)
}

/// Multi-field form: Up/Down (or k/j) moves, typing edits text rows,
/// Enter toggles confirm / advances, Left/Right cycles select,
/// Tab advances, Enter on the last row or Ctrl+D submits, Esc
/// cancels ([]). Answers come back as strings in field order
/// (confirm yields "true"/"false").
pub func form(title: str, fields: [fm.Field]) -> [str] {
    fm.run(title, fields)
}

/// Fuzzy-filter select: type narrows the list, Up/Down (or k/j)
/// moves, Enter accepts, Esc cancels ("").
pub func search(msg: str, options: [str]) -> str {
    sch.search(msg, options)
}

/// Yes/no prompt. Hint follows the default (`[Y/n]` / `[y/N]`).
/// y/n or Enter answers; other keys are ignored.
pub func confirm(msg: str, def: bool) -> bool {
    cf.confirm(msg, def, "")
}

/// Yes/no prompt with a custom hint label.
pub func confirm_hint(msg: str, def: bool, hint: str) -> bool {
    cf.confirm(msg, def, hint)
}

/// Single choice menu: Up/Down (or k/j) moves, Enter accepts.
// Returns the chosen option string ("" when `options` is empty).
pub func select(msg: str, options: [str]) -> str {
    sel.select(msg, options)
}

/// Multi-select menu: Up/Down moves, Space toggles `[x]`/`[ ]`,
/// Enter confirms. Returns the selected option strings.
pub func multi_select(msg: str, options: [str]) -> [str] {
    sel.multi_select(msg, options)
}
