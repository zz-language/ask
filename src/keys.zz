// keys.zz — raw key reading plus pure escape-sequence decoding.
//
// `next()` blocks for one logical key and returns either the raw byte
// (0-255) or one of the KEY_* codes below. Byte 3 is Ctrl+C (ISIG stays
// off in raw mode), -1 means the read failed (closed stdin).
import std.term

pub const KEY_EOF: int = -1
pub const KEY_CTRL_C: int = 3
pub const KEY_TAB: int = 9
pub const KEY_ENTER: int = 13
pub const KEY_ESC: int = 27
pub const KEY_SPACE: int = 32
pub const KEY_BACKSPACE: int = 127
pub const KEY_LEFT: int = 1000
pub const KEY_RIGHT: int = 1001
pub const KEY_UP: int = 1002
pub const KEY_DOWN: int = 1003
pub const KEY_HOME: int = 1004
pub const KEY_END: int = 1005
pub const KEY_DELETE: int = 1006

/// Map a CSI / SS3 final byte to a KEY_* code (pure, unit-testable).
/// Arrows: 65 up, 66 down, 67 right, 68 left. Home/End: 72 / 70.
/// Unknown finals pass through as their own byte value.
pub func decode_csi(fin: int) -> int {
    if fin == 65 {
        return KEY_UP
    }
    if fin == 66 {
        return KEY_DOWN
    }
    if fin == 67 {
        return KEY_RIGHT
    }
    if fin == 68 {
        return KEY_LEFT
    }
    if fin == 72 {
        return KEY_HOME
    }
    if fin == 70 {
        return KEY_END
    }
    fin
}

/// Map a `~`-terminated sequence number to a KEY_* code (pure).
/// 1 = Home, 3 = Delete, 4 = End. Anything else passes through.
pub func decode_tilde(n: int) -> int {
    if n == 1 {
        return KEY_HOME
    }
    if n == 3 {
        return KEY_DELETE
    }
    if n == 4 {
        return KEY_END
    }
    n
}

/// One raw byte from stdin, or -1 when the read fails.
func read_raw() -> int {
    match term.read_key() {
        .ok(k) => k
        .err(_) => -1
    }
}

/// Read one logical key: printable bytes pass through, ESC introducers
/// (`\x1b[` + final, `\x1bO` + final, `\x1b[<n>~`) decode to KEY_* codes,
/// a lone ESC returns KEY_ESC, failures return KEY_EOF.
pub func next() -> int {
    b := read_raw()
    if b == -1 {
        return KEY_EOF
    }
    if b != KEY_ESC {
        return b
    }
    b2 := read_raw()
    if b2 == -1 {
        return KEY_ESC
    }
    if b2 == 91 {
        b3 := read_raw()
        if b3 == -1 {
            return KEY_ESC
        }
        if b3 >= 49 && b3 <= 52 {
            b4 := read_raw()
            if b4 == 126 {
                return decode_tilde(b3 - 48)
            }
            return decode_csi(b3)
        }
        return decode_csi(b3)
    }
    if b2 == 79 {
        b3 := read_raw()
        if b3 == -1 {
            return KEY_ESC
        }
        return decode_csi(b3)
    }
    KEY_ESC
}
