// ansi.zz — cursor shapes, visibility, block erasing, final answer lines.
//
// Every helper flushes stdout (`term.flush`) because interactive renders
// carry no trailing newline and `print` alone never flushes.
import std.term
import theme

/// Hide the terminal cursor (menus).
pub func hide() {
    print("\x1b[?25l")
    term.flush()
}

/// Restore the terminal cursor.
pub func show() {
    print("\x1b[?25h")
    term.flush()
}

/// Ring the terminal bell (validation nudges without layout churn).
pub func bell() {
    print("\x07")
    term.flush()
}

/// Steady bar cursor for line editing (spec: `\x1b[5q`).
pub func bar() {
    print("\x1b[5q")
    term.flush()
}

/// Reset cursor shape to the terminal default (spec: `\x1b[0q`).
pub func reset_shape() {
    print("\x1b[0q")
    term.flush()
}

/// Move up `lines` rows and erase everything below the cursor.
/// Only correct when the cursor sits BELOW the block (e.g. `select`,
/// whose draws end with a newline). When the cursor rests inside the
/// block (`search`, `area`), use `wipe_down` instead — moving up from
/// mid-block erases unrelated lines above the menu.
pub func wipe(lines: int) {
    if lines <= 0 {
        return
    }
    print("\x1b[{lines}A\x1b[J")
    term.flush()
}

/// Erase the current line from column 0 to the end of the screen.
/// Correct when the cursor sits on the FIRST line of the block being
/// redrawn: no upward move, so lines above are never touched.
pub func wipe_down() {
    print("\r\x1b[J")
    term.flush()
}

/// Move up `n` rows without erasing (callers follow with `wipe_down`).
/// Used when the cursor rests mid-block: climb back to the header
/// first, so the erase below never reaches above the menu.
pub func up_lines(n: int) {
    if n <= 0 {
        return
    }
    print("\x1b[{n}A")
    term.flush()
}

/// Print the collapsed result line: `<prefix><msg> <answer>` (msg
/// bold, answer in the theme color) and leave the cursor next line.
pub func answer(msg: str, val: str) {
    t := theme.current()
    print("\r\x1b[K" + t.prefix)
    print(theme.paint(t, "bold", msg))
    print(" ")
    println(theme.paint(t, t.answer, val))
}

/// Restore a prompt to a safe terminal state: cooked mode back on,
/// cursor visible, default shape. Safe to call unconditionally.
pub func restore() {
    match term.disable_raw() {
        .ok(_) => 0
        .err(_) => 0
    }
    show()
    reset_shape()
}
