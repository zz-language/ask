// Demo of the ask package. Raw prompts need a real TTY; with piped
// stdin every prompt degrades to plain input() automatically.
// Run from examples/:
//   zz install && zz run demo.zz
import ask

func main() {
    // 1. Text with cursor navigation + validation (min 3 chars).
    name := ask.text_msg("Name:", "ada", |s: str| len(s) > 2, "Need 3+ chars")
    println("hello {name}")
    // 2. Confirmation, both default styles.
    deploy := ask.confirm("Deploy to prod?", false)
    println("deploy: {deploy}")
    verbose := ask.confirm("Verbose logs?", true)
    println("verbose: {verbose}")
    // 3. Masked input with a custom mask character.
    token := ask.password_mask("API token:", "#")
    println("token length: {len(token)}")
    // 4. Single select (arrows or k/j, Enter accepts).
    env := ask.select("Target:", ["dev", "stage", "prod"])
    println("env: {env}")
    // 5. Multi-select (Space toggles, Enter confirms).
    feats := ask.multi_select("Features:", ["logs", "cache", "tls"])
    println("feats: {feats}")
    // 6. Ranged number (150 rejected, 25 accepted).
    age := ask.number("Age:", 30, 1, 120)
    println("age: {age}")
    // 7. Path input with Tab completion (plain input when piped).
    cfg := ask.text_path("Config:", "./")
    println("cfg: {cfg}")
    // 8. Fuzzy search (type narrows, arrows move, Enter picks).
    shell := ask.search("Shell:", ["bash", "zsh", "fish", "powershell", "nu"])
    println("shell: {shell}")
    // 9. Destructive confirm (must type the word exactly).
    gone := ask.confirm_delete("Nuke ./build?")
    println("gone: {gone}")
    // 10. Multi-line area (Ctrl+D accepts; piped: empty line ends).
    bio := ask.area("Bio:", "hi", 4)
    println("bio: {bio}")
    // 11. External editor (piped: lines until empty).
    notes := ask.editor("Notes:", "draft")
    println("notes: {notes}")
    // 12. Ocean theme for one screen.
    ask.set_theme("ocean")
    // 13. Multi-field form (piped: sequential prompts).
    who := ask.form("Who:", [ask.field_text("Name", "ada"), ask.field_number("Age", 30, 1, 120), ask.field_confirm("Admin?", false), ask.field_select("Shell", ["bash", "zsh"])])
    println("who: {who}")
    ask.set_theme("default")
    println("demo_ok")
}
